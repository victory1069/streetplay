# --- Local mode (no Supabase needed) ---
# 1 = the app runs the real migrations in a local Postgres (PGlite, saved in
# .demo-data/) seeded with a demo show (supabase/seed/demo.sql). Sign in on
# the landing page with any Nigerian number and the code below. The demo
# account is 0803 555 0142 (Tobi).
# NEXT_PUBLIC_DEMO_MODE=1
# DEMO_OTP=123456

# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Public base URL. Its host is what's read out on camera ("sp.ng/r/7Q4K2R").
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Payments ---
# "mock" never moves money, passes KYC instantly and lets you simulate
# transfers into the wallet. "paystack" is real.
PAYMENTS_PROVIDER=mock
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYSTACK_DVA_BANK=wema-bank
# Flat fee per transfer in kobo, passed through at cost (default ₦50).
# PAYOUT_FEE_KOBO=5000

# --- SMS (receipts, claim codes, delete-my-data codes) ---
# "mock" logs to the sms_log table and the server console.
SMS_PROVIDER=mock
# TERMII_API_KEY=
# TERMII_SENDER_ID=StreetPlay
# TERMII_BASE_URL=https://v3.api.termii.com
# Shown in claim-code SMS ("or call 0700 STREET").
# SUPPORT_PHONE=

# --- Web push ("ping me when Tobi goes live") ---
# Generate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@streetplay.ng
